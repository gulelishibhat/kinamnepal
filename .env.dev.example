# ═══════════════════════════════════════════════════════════════════
#  MK Electric Shop — DEV / STAGING (AWS)
#  Copy to .env.dev and fill in. Do NOT commit the filled file.
#  In App Runner these become service environment variables / secrets.
# ═══════════════════════════════════════════════════════════════════

APP_ENV=dev

# ─── Database (RDS / Aurora Serverless v2, dev instance) ────
# Use the RDS endpoint. Prefer storing this in AWS Secrets Manager.
DATABASE_URL=postgresql://mkelectric:CHANGE_ME@mkelectric-dev.xxxx.us-west-2.rds.amazonaws.com:5432/mkelectricshop

# ─── JWT (generate: openssl rand -base64 48) ────────────────
JWT_ACCESS_SECRET=CHANGE_ME_dev_access_secret
JWT_REFRESH_SECRET=CHANGE_ME_dev_refresh_secret
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=16h

# ─── API Server ─────────────────────────────────────────────
# App Runner injects PORT; keep API_PORT aligned or read PORT in code.
API_PORT=8080
API_HOST=https://api-dev.mkelectric.example.com

# ─── CORS (dev frontend CloudFront URLs) ────────────────────
CORS_ORIGINS=https://dev.mkelectric.example.com,https://admin-dev.mkelectric.example.com

# ─── Auth cookies ───────────────────────────────────────────
# If API + frontends share a parent domain: lax / true.
# If they are on unrelated domains (cross-site): none / true.
COOKIE_SAMESITE=lax
COOKIE_SECURE=true

# ─── Storage (S3, dev bucket) ───────────────────────────────
STORAGE_DRIVER=s3
S3_REGION=us-west-2
S3_BUCKET=mkelectric-media-dev
# Leave keys BLANK — App Runner uses the instance IAM role.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
# CloudFront distribution domain for media (optional but recommended)
S3_PUBLIC_BASE_URL=https://media-dev.mkelectric.example.com

# ─── Email ──────────────────────────────────────────────────
# Not used — customers are contacted by phone. No email service configured.

# ─── Store Settings ─────────────────────────────────────────
STORE_NAME=MK Electric Shop
STORE_QR_UPI_ID=CHANGE_ME@bank
STORE_CURRENCY=NPR
STORE_LOW_STOCK_THRESHOLD=5

# ─── Admin Seed (first run only) ────────────────────────────
SEED_ADMIN_EMAIL=admin@mkelectric.example.com
SEED_ADMIN_PASSWORD=CHANGE_ME_strong_password
SEED_ADMIN_NAME=Admin
