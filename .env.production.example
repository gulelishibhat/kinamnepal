# ═══════════════════════════════════════════════════════════════════
#  MK Electric Shop — PRODUCTION (AWS)
#  Copy to .env.production and fill in. Do NOT commit the filled file.
#  Strongly prefer AWS Secrets Manager for DATABASE_URL and JWT secrets;
#  reference them as App Runner secrets rather than plaintext env vars.
# ═══════════════════════════════════════════════════════════════════

APP_ENV=production

# ─── Database (RDS / Aurora Serverless v2, production) ──────
DATABASE_URL=postgresql://mkelectric:CHANGE_ME@mkelectric-prod.xxxx.us-west-2.rds.amazonaws.com:5432/mkelectricshop

# ─── JWT (generate: openssl rand -base64 48 — unique per env) ──
JWT_ACCESS_SECRET=CHANGE_ME_prod_access_secret
JWT_REFRESH_SECRET=CHANGE_ME_prod_refresh_secret
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=16h

# ─── API Server ─────────────────────────────────────────────
API_PORT=8080
API_HOST=https://api.mkelectric.example.com

# ─── CORS (production frontend domains only) ────────────────
CORS_ORIGINS=https://mkelectric.example.com,https://admin.mkelectric.example.com

# ─── Auth cookies ───────────────────────────────────────────
# Shared parent domain → lax/true. Unrelated cross-site domains → none/true.
COOKIE_SAMESITE=lax
COOKIE_SECURE=true

# ─── Storage (S3, production bucket + CloudFront) ───────────
STORAGE_DRIVER=s3
S3_REGION=us-west-2
S3_BUCKET=mkelectric-media-prod
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=https://media.mkelectric.example.com

# ─── Email ──────────────────────────────────────────────────
# Not used — customers are contacted by phone. No email service configured.

# ─── Store Settings ─────────────────────────────────────────
STORE_NAME=MK Electric Shop
STORE_QR_UPI_ID=CHANGE_ME@bank
STORE_CURRENCY=NPR
STORE_LOW_STOCK_THRESHOLD=5

# ─── Admin Seed (first run only — change password immediately) ──
SEED_ADMIN_EMAIL=admin@mkelectric.example.com
SEED_ADMIN_PASSWORD=CHANGE_ME_strong_password
SEED_ADMIN_NAME=Admin
