# ═══════════════════════════════════════════════════════════════════
#  MK Electric Shop — Environment Template
#  Copy to .env (local), .env.dev, or .env.production and fill in.
#  The API loads .env.<APP_ENV> first, then falls back to .env.
# ═══════════════════════════════════════════════════════════════════

# APP_ENV selects behaviour: local | dev | production
# - local      → disk storage, console email (no external services)
# - dev/prod   → S3 storage, SES email
APP_ENV=local

# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql://mkelectric:mkelectric123@localhost:5432/mkelectricshop

# ─── JWT (use long random strings; NEVER commit real secrets) ───
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=16h

# ─── API Server ─────────────────────────────────────────────
API_PORT=4000
API_HOST=http://localhost:4000

# ─── CORS (comma-separated allowed origins) ─────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ─── Storage ────────────────────────────────────────────────
# STORAGE_DRIVER: disk (local) | s3 (dev/prod). Defaults by APP_ENV.
STORAGE_DRIVER=disk
# disk driver
UPLOAD_DIR=./uploads
PUBLIC_UPLOAD_BASE_URL=http://localhost:4000/uploads
# s3 driver (leave keys blank on AWS to use the IAM role)
S3_REGION=us-west-2
S3_BUCKET=mkelectric-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=

# ─── Email ──────────────────────────────────────────────────
# Email/notifications are NOT used in this build. Orders are contacted by
# phone via the admin dashboard. No email service required.

# ─── Store Settings ─────────────────────────────────────────
STORE_NAME=MK Electric Shop
STORE_QR_UPI_ID=placeholder@bank
STORE_CURRENCY=NPR
STORE_LOW_STOCK_THRESHOLD=5

# ─── Admin Seed (first run only) ────────────────────────────
SEED_ADMIN_EMAIL=admin@mkelectric.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=Admin
