# ═══════════════════════════════════════════════════════════════════
#  Elastic Beanstalk environment options for the MK Electric API.
#  Node.js 22 on Amazon Linux 2023.
#
#  The app is started via the root Procfile (node packages/api/dist/index.js).
#  On AL2023 the old `aws:elasticbeanstalk:container:nodejs` namespace and
#  `NodeCommand` no longer exist — do not use them.
#
#  Runtime env vars / secrets are supplied at environment-create time
#  (DATABASE_URL, JWT_*, S3_*, CORS_ORIGINS, etc.).
# ═══════════════════════════════════════════════════════════════════
option_settings:
  aws:elasticbeanstalk:environment:proxy:
    ProxyServer: nginx
